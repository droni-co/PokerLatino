<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <title>{{ title }} · Poker Latino</title>
    <style nonce="{{ cspNonce }}">
      :root {
        --felt: #0b3d2e;
        --felt-dark: #062419;
        --card: #0f2a22;
        --border: #1f5a45;
        --text: #f2efe6;
        --muted: #a9c2b6;
        --gold: #e3b341;
        --gold-dark: #b8892a;
        --danger: #ff7b72;
        --radius: 14px;
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: 24px 16px;
        font:
          16px/1.5 system-ui,
          -apple-system,
          'Segoe UI',
          Roboto,
          sans-serif;
        color: var(--text);
        background: radial-gradient(ellipse at top, var(--felt) 0%, var(--felt-dark) 70%);
      }
      main {
        width: 100%;
        max-width: 400px;
      }
      .brand {
        text-align: center;
        margin-bottom: 20px;
      }
      .brand .suits {
        font-size: 28px;
        letter-spacing: 6px;
      }
      .brand .suits .red {
        color: #e5534b;
      }
      .brand h2 {
        margin: 4px 0 0;
        font-size: 20px;
        color: var(--gold);
        letter-spacing: 0.5px;
      }
      .card {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 28px 24px;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.35);
      }
      h1 {
        margin: 0 0 20px;
        font-size: 22px;
      }
      label {
        display: block;
        font-size: 14px;
        color: var(--muted);
        margin: 14px 0 6px;
      }
      input[type='email'],
      input[type='password'],
      input[type='date'],
      input[type='text'] {
        width: 100%;
        padding: 12px 14px;
        font-size: 16px;
        color: var(--text);
        background: var(--felt-dark);
        border: 1px solid var(--border);
        border-radius: 10px;
      }
      input:focus {
        outline: 2px solid var(--gold);
        outline-offset: 1px;
        border-color: transparent;
      }
      .field-error {
        color: var(--danger);
        font-size: 13px;
        margin-top: 4px;
      }
      .hint {
        color: var(--muted);
        font-size: 12px;
        margin-top: 4px;
      }
      .alert {
        background: rgba(255, 123, 114, 0.12);
        border: 1px solid var(--danger);
        color: var(--danger);
        padding: 10px 12px;
        border-radius: 10px;
        font-size: 14px;
        margin-bottom: 8px;
      }
      button {
        width: 100%;
        margin-top: 22px;
        padding: 12px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        color: #1a1405;
        background: var(--gold);
        border: 0;
        border-radius: 10px;
      }
      button:hover,
      a.button:hover {
        background: var(--gold-dark);
      }
      a.button {
        display: block;
        text-align: center;
        text-decoration: none;
        margin-top: 22px;
        padding: 12px;
        font-size: 16px;
        font-weight: 600;
        color: #1a1405;
        background: var(--gold);
        border-radius: 10px;
      }
      button.secondary {
        background: transparent;
        color: var(--text);
        border: 1px solid var(--border);
      }
      button.link {
        background: none;
        color: var(--muted);
        width: auto;
        margin: 0;
        padding: 0;
        font-weight: 400;
        text-decoration: underline;
        font-size: 14px;
      }
      .footer {
        text-align: center;
        margin-top: 18px;
        font-size: 14px;
        color: var(--muted);
      }
      a {
        color: var(--gold);
      }
      ul.scopes {
        padding-left: 20px;
        margin: 8px 0 0;
      }
      ul.scopes li {
        margin: 6px 0;
      }
      .muted {
        color: var(--muted);
        font-size: 14px;
      }
    </style>
  </head>
  <body>
    <main>
      <div class="brand">
        <div class="suits" aria-hidden="true">
          ♠<span class="red">♥</span><span class="red">♦</span>♣
        </div>
        <h2>Poker Latino</h2>
      </div>
      <div class="card">{{{ await $slots.main() }}}</div>
    </main>
  </body>
</html>
