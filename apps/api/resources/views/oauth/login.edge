@component('components/layout', { title: 'Iniciar sesión' })
  <h1>Iniciar sesión</h1>

  @flashMessage('error')
    <div class="alert" role="alert">{{ $message }}</div>
  @end

  <form method="POST" action="/oauth/login" novalidate>
    {{ csrfField() }}

    <label for="email">Email</label>
    <input id="email" type="email" name="email" value="{{ flashMessages.get('email', '') }}"
      autocomplete="email" required autofocus>
    @inputError('email')
      <div class="field-error">{{ $messages[0] }}</div>
    @end

    <label for="password">Contraseña</label>
    <input id="password" type="password" name="password" autocomplete="current-password" required>
    @inputError('password')
      <div class="field-error">{{ $messages[0] }}</div>
    @end

    <button type="submit">Entrar</button>
  </form>

  <p class="footer">¿No tienes cuenta? <a href="/oauth/register">Regístrate</a></p>
@end
