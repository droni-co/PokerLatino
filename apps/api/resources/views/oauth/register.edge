@component('components/layout', { title: 'Crear cuenta' })
  <h1>Crear cuenta</h1>

  <form method="POST" action="/oauth/register" novalidate>
    {{ csrfField() }}
    <label for="username">Nombre de usuario</label>
    <input
      id="username"
      type="text"
      name="username"
      value="{{ flashMessages.get('username', '') }}"
      autocomplete="username"
      minlength="3"
      maxlength="20"
      required
      autofocus
    />
    <div class="hint">Así te verán en las mesas. 3 a 20 caracteres, sin espacios.</div>
    @inputError('username')
      <div class="field-error">{{ $messages[0] }}</div>
    @end

    <label for="email">Email</label>
    <input
      id="email"
      type="email"
      name="email"
      value="{{ flashMessages.get('email', '') }}"
      autocomplete="email"
      required
    />
    @inputError('email')
      <div class="field-error">{{ $messages[0] }}</div>
    @end

    <label for="birth_date">Fecha de nacimiento</label>
    <input
      id="birth_date"
      type="date"
      name="birth_date"
      value="{{ flashMessages.get('birth_date', '') }}"
      autocomplete="bday"
      required
    />
    @inputError('birth_date')
      <div class="field-error">{{ $messages[0] }}</div>
    @end

    <label for="password">Contraseña</label>
    <input
      id="password"
      type="password"
      name="password"
      autocomplete="new-password"
      minlength="8"
      required
    />
    @inputError('password')
      <div class="field-error">{{ $messages[0] }}</div>
    @end

    <label for="password_confirmation">Repite la contraseña</label>
    <input
      id="password_confirmation"
      type="password"
      name="password_confirmation"
      autocomplete="new-password"
      required
    />
    @inputError('password_confirmation')
      <div class="field-error">{{ $messages[0] }}</div>
    @end

    <label for="referral_code">Código de invitación (opcional)</label>
    <input
      id="referral_code"
      type="text"
      name="referral_code"
      value="{{ flashMessages.get('referral_code', referralCode || '') }}"
      autocomplete="off"
      maxlength="16"
      style="text-transform: uppercase"
    />
    <div class="hint">Si un amigo te invitó, ambos reciben fichas extra.</div>
    @inputError('referral_code')
      <div class="field-error">{{ $messages[0] }}</div>
    @end

    <button type="submit">Crear cuenta</button>
  </form>

  <p class="footer">¿Ya tienes cuenta? <a href="/oauth/login">Inicia sesión</a></p>
@end
