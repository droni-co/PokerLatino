@component('components/layout', { title: 'Crear cuenta' })
  <h1>Crear cuenta</h1>

  <form method="POST" action="/oauth/register" novalidate>
    {{ csrfField() }}

    <label for="email">Email</label>
    <input id="email" type="email" name="email" value="{{ flashMessages.get('email', '') }}"
      autocomplete="email" required autofocus>
    @inputError('email')
      <div class="field-error">{{ $messages[0] }}</div>
    @end

    <label for="birth_date">Fecha de nacimiento</label>
    <input id="birth_date" type="date" name="birth_date" value="{{ flashMessages.get('birth_date', '') }}"
      autocomplete="bday" required>
    @inputError('birth_date')
      <div class="field-error">{{ $messages[0] }}</div>
    @end

    <label for="password">Contraseña</label>
    <input id="password" type="password" name="password" autocomplete="new-password" minlength="8" required>
    @inputError('password')
      <div class="field-error">{{ $messages[0] }}</div>
    @end

    <label for="password_confirmation">Repite la contraseña</label>
    <input id="password_confirmation" type="password" name="password_confirmation" autocomplete="new-password" required>
    @inputError('password_confirmation')
      <div class="field-error">{{ $messages[0] }}</div>
    @end

    <button type="submit">Crear cuenta</button>
  </form>

  <p class="footer">¿Ya tienes cuenta? <a href="/oauth/login">Inicia sesión</a></p>
@end
